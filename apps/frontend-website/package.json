		"react-dom": "^19.0.0",
		"react-router": "^7.5.1"
	},
	"devDependencies": {
		"@react-router/dev": "^7.5.1",
		"@tailwindcss/vite": "^4.0.0",
		"@types/node": "^20",
		"@types/react": "^19.0.1",
		"@types/react-dom": "^19.0.1",
		"@vitest/browser": "^3.1.2",
		"autoprefixer": "^10.4.21",
		"postcss": "^8.5.3",
		"react-router-devtools": "^1.1.0",
		"tailwindcss": "^3.4.17",
		"typescript": "^5.7.2",
		"vite": "^5.4.11",
		"vite-tsconfig-paths": "^5.1.4",
		"vitest": "^3.1.2",

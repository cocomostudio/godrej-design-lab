# Development values. These carry no secrets and are safe in version control —
# they exist so that a fresh clone boots with one command. Production supplies
# its own.
#
#
# `scripts/ensure-local-env.js` copies this to `apps/frontend-website/.env` on a
# fresh clone and never overwrites an existing one.
#
# **Which file is read is decided in package.json**, not by a variable:
# `dev` reads `.env`, `start` reads `.env.production`. Both use
# `--env-file-if-exists`, so a missing file is not an error — the server boots
# on defaults, with no preview secret and a CMS URL pointing at localhost, and
# says nothing. If production looks like it is running on nobody's
# configuration, check the file exists before checking anything else.
#
# Node lets the real environment win over the file, so anything PM2 sets in its
# `env_production` block overrides what is written here. That is why the port
# lives in this file and not in the ecosystem config.
#
# Generating a value for anything below marked "random":
#
#     openssl rand -base64 32


# ─── Server ───────────────────────────────────────────────────────────────────

# The port the Express server listens on. Anything unparseable falls back to
# 3000 rather than failing.
#
# 3000 is what the stock React Router server settled on, and what nginx already
# proxies to on the website host. Nothing reconciles the two.
# HTTP_SERVER_PORT=3000

# Whether this process builds the browser's assets or merely serves them.
#
# `vite` mounts a Vite development server in this process — transforming on
# demand, with hot module replacement. `static` serves what `react-router build`
# already wrote.
#
# Empty hands the decision back to the environment: `static` in production, a
# Vite server everywhere else. An unrecognised value refuses the boot rather
# than falling back, because an override that silently did not take is not
# visible from anywhere afterwards.
#
# Set it to `static` to reproduce a rendering fault that only appears in the
# production bundle, without having to claim to be production.
SERVE_MODE=


# ─── The CMS ──────────────────────────────────────────────────────────────────

# The CMS's origin **as this server reaches it**. Only this process ever dials
# it, so it is free to be an address only this process can resolve — a loopback
# port, a private host inside the VPC.
#
# Defaults to http://localhost:1337, which is right in development where both
# apps are on one machine. When they are on separate machines, this must be set
# or every page fails on a connection error.
# CMS_URL=http://localhost:1337

# The name the CMS answers to, when CMS_URL is an address rather than a name.
# Sent as the Host header — which is what routes the request to Strapi rather
# than to another application on the same machine — and as the TLS server name,
# so the certificate still matches. Leave unset where the CMS is the only thing
# listening.
CMS_HOST_NAME=

# The CMS's origin **as a browser reaches it**, which is a different question
# and frequently a different answer: CMS_URL may be an address no visitor can
# resolve. This one goes in front of every relative `/uploads/…` path the CMS
# hands back, and ends up in an `src` attribute in someone else's browser.
#
# Unset, it falls back to CMS_URL — right in development, where the two are the
# same machine.
#
# In production this matters less than it looks: the S3 upload provider returns
# absolute CDN URLs, and `media_url()` passes absolute URLs through untouched.
# This is the fallback for any upload still carrying a relative path from before
# S3 — so it should be the CDN's origin, and must not be empty.
CMS_PUBLIC_URL=

# The CMS's origins **as a browser sees them** — a third answer again, and
# different from both of the above: CMS_URL is a private address only the
# server can resolve, and CMS_PUBLIC_URL is the CDN in front of the media.
# This one is where the admin panel is served from.
#
# It exists for exactly one reason: the admin panel frames this website for
# Entry Preview, so the content security policy has to name it as a permitted
# frame ancestor. The same value is CMS_URLS in apps/cms/.env on the CMS
# machine. It is not called that here because CMS_URL above already means
# something else, and two keys one letter apart with unrelated meanings is a
# trap rather than a symmetry.
#
# Comma-separated, and a value without a scheme is read as https:// — the
# deployed hosts write bare hostnames, which is the form the CMS's own origin
# lists already take.
#
# Empty is allowed. The policy ships report-only, so an unset value costs a
# console report during Entry Preview and nothing else — until the policy is
# promoted to enforcing, at which point it costs Entry Preview.
#
# The value below is a development value, like everything else in this file:
# it is the CMS a fresh clone runs locally. **Production must overwrite it**
# in .env.production. A localhost origin left in a live frame-ancestors list
# is a permitted framer nobody intended — only a program on the visitor's own
# machine could occupy it, but that is a weaker sentence than "nothing can".
CMS_ADMIN_URLS=http://localhost:1337


# ─── Signing secrets ──────────────────────────────────────────────────────────

# Random. The secret the CMS signs preview links with, and this server verifies
# before it will ask the CMS for unpublished content.
#
# Must equal PREVIEW_SECRET in apps/cms/.env on the CMS machine. The two are on
# different machines and nothing reconciles them.
#
# **No default.** A fallback here would be a shared secret somebody could ship
# without meaning to, and the failure it prevents — unpublished content readable
# by anyone who guesses a query parameter — is not one anybody notices from
# outside.
PREVIEW_LINK_SECRET=development-preview-link-secret


# ─── Set elsewhere, not here ──────────────────────────────────────────────────
#
# NODE_ENV   Set by the package.json script itself — "development" for `dev`,
#            "production" for `start` — and again by PM2.
# APP_ENV    What the application actually reads, falling back to NODE_ENV.
#            **Only the exact string "production" counts as production.** A
#            typo does not fail; it silently reads as development.
#
# See infra/production/website-host/pm2/ecosystem.config.cjs.

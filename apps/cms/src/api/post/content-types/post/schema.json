				[
					{ "name": "page_context", "size": 6 },
					{ "name": "color_scheme", "size": 6 }
				],
				[
					{ "name": "cover", "size": 6 },
					{ "name": "category", "size": 6 }
				],
				[
					{ "name": "header_region", "size": 12 }

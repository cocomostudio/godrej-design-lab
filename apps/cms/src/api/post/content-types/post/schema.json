{
	"kind": "collectionType",
	"collectionName": "posts_v1",
	"info": {
		"singularName": "post",
		"pluralName": "posts",
		"displayName": "Posts",
		"description": "Create your blog content"
	},
	"options": {
		"draftAndPublish": true
	},
	"pluginOptions": {
		"webtools": {
			"enabled": true
		}
	},
	"attributes": {
		"title": {
			"type": "string",
			"required": true
		},
		"cover": {
			"type": "component",
			"component": "media.image-v1"
		},
		"category": {
			"type": "relation",
			"relation": "manyToOne",
			"target": "api::post-category.post-category",
			"inversedBy": "posts"
		},
		"header_region": {
			"type": "dynamiczone",
			"components": [
				"container.section-v1"
			]
		},
		"main_region": {
			"type": "dynamiczone",
			"components": [
				"container.section-v1"
			]
		},
		"side_region": {
			"type": "dynamiczone",
			"components": [
				"container.section-v1"
			]
		},
		"url_alias": {
			"type": "relation",
			"relation": "oneToMany",
			"target": "plugin::webtools.url-alias",
			"writable": true,
			"configurable": false,
			"editable": false,
			"visible": false,
			"unique": true
		}
	}
}

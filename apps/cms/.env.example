# Server
HOST=0.0.0.0
PORT=1337

# Secrets
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified

# Database
DATABASE_CLIENT=sqlite
DATABASE_HOST=
DATABASE_PORT=
DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_SSL=false
DATABASE_FILENAME=environment/database/sqlite-data.db

# This CMS
# The origin(s) a browser reaches this CMS on. Comma-separated.
CMS_URLS=

# Frontend
# The origin(s) the website is reached on. Comma-separated.
CLIENT_URLS=

# The secret this CMS signs Entry Preview links with, and which the website
# verifies before it will ask for unpublished content. Without a matching pair,
# Entry Preview shows the published page instead of the draft.
#
# Must equal PREVIEW_LINK_SECRET in apps/frontend-website/.env (or
# .env.production) on the website machine. The two are on different machines and
# nothing reconciles them.
#
# The value below is a development value and production must overwrite it.
# Generate one with: openssl rand -base64 32
PREVIEW_SECRET=development-preview-link-secret
